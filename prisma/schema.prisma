generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountType {
  CLIENT
  PROVIDER
}

enum JobStatus {
  PENDING_REVIEW
  NEEDS_EDIT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  ONLINE
  FIELD
  BOTH
}

enum Region {
  NORTH_GAZA
  GAZA_CITY
  CENTRAL
  KHAN_YOUNIS
  RAFAH
  ONLINE
}

enum NotificationType {
  NEW_OFFER
  OFFER_ACCEPTED
  OFFER_REJECTED
  NEW_REVIEW
  REPORT_UPDATE
  SYSTEM
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  JOB_POST
}

enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  SERVICE
  PHYSICAL
}

enum ListingStatus {
  PENDING_REVIEW
  NEEDS_EDIT
  REJECTED
  ACTIVE
  PAUSED
  SOLD_OUT
  DELETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliveryMethod {
  IN_PERSON
  DELIVERY
  ONLINE
  WHATSAPP
}

enum StorePlan {
  GAZA
  MAJDAL
  QUDS
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String?     @unique
  phone        String?     @unique
  passwordHash String
  role         UserRole    @default(USER)
  accountType  AccountType @default(CLIENT)
  storePlan    StorePlan   @default(GAZA)
  isVerified   Boolean     @default(false)
  isBanned     Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile              Profile?
  jobPosts             JobPost[]
  offers               Offer[]
  reviewsGiven         Review[]                      @relation("ReviewsGiven")
  reviewsReceived      Review[]                      @relation("ReviewsReceived")
  reports              Report[]
  savedJobs            SavedJob[]
  notifications        Notification[]
  resetTokens          PasswordResetToken[]
  emailTokens          EmailVerificationToken[]
  verificationRequests ProviderVerificationRequest[] @relation("ProviderVerificationRequests")
  listings             Listing[]
  orders               Order[]                       @relation("OrderBuyer")
  savedListings        SavedListing[]
  listingReviews       ListingReview[]
  listingReports       ListingReport[]
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  title         String?
  bio           String?
  region        Region
  workMode      WorkMode @default(BOTH)
  avatarUrl     String?
  whatsapp      String?
  showWhatsapp  Boolean  @default(false)
  portfolioUrls String[] @default([])
  avgRating     Float    @default(0)
  totalReviews  Int      @default(0)
  isTrusted     Boolean  @default(false)
  isAvailable   Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         ProfileSkill[]
  portfolioItems PortfolioItem[]
}

model Category {
  id    String  @id @default(cuid())
  name  String  @unique
  slug  String  @unique
  icon  String?
  color String?

  jobPosts JobPost[]
  listings Listing[]
}

model Skill {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  profiles ProfileSkill[]
}

model ProfileSkill {
  profileId String
  skillId   String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model JobPost {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  description String
  budget      String?
  duration    String?
  isUrgent    Boolean   @default(false)
  views       Int       @default(0)
  region      Region
  workMode    WorkMode
  status      JobStatus @default(PENDING_REVIEW)
  expiresAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String
  categoryId  String

  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers   Offer[]
  savedBy  SavedJob[]
  reports  Report[]   @relation("JobPostReports")
  reviews  Review[]

  @@index([status, region, categoryId, isUrgent, createdAt])
  @@index([status, createdAt])
  @@index([status, region, categoryId])
  @@index([isUrgent, createdAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([code])
}

model Offer {
  id         String      @id @default(cuid())
  message    String
  price      String?
  duration   String?
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  jobPostId  String
  providerId String

  jobPost  JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  provider User    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, providerId])
  @@index([jobPostId, providerId, status])
  @@index([providerId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  giverId    String
  receiverId String
  jobPostId  String?

  giver    User     @relation("ReviewsGiven", fields: [giverId], references: [id], onDelete: Cascade)
  receiver User     @relation("ReviewsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  jobPost  JobPost? @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  @@unique([giverId, jobPostId])
  @@index([giverId])
  @@index([receiverId])
  @@index([receiverId, createdAt])
  @@index([jobPostId])
}

model SavedJob {
  userId    String
  jobPostId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@id([userId, jobPostId])
  @@index([jobPostId])
}

model Listing {
  id             String         @id @default(cuid())
  title          String
  description    String         @db.Text
  type           ListingType
  price          Float
  priceLabel     String?
  deliveryMethod DeliveryMethod
  deliveryTime   String?
  region         Region
  quantity       Int?
  images         String[]       @default([])
  tags           String[]       @default([])
  status         ListingStatus  @default(PENDING_REVIEW)
  viewCount      Int            @default(0)
  shareCount     Int            @default(0)
  avgRating      Float          @default(0)
  totalReviews   Int            @default(0)
  isFeatured     Boolean        @default(false)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sellerId       String
  categoryId     String

  seller   User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orders   Order[]
  reviews  ListingReview[]
  savedBy  SavedListing[]
  reports  ListingReport[]

  @@index([status, type, region, categoryId])
  @@index([sellerId])
  @@index([categoryId])
  @@index([isFeatured, createdAt])
  @@index([deletedAt])
}

model Order {
  id            String      @id @default(cuid())
  quantity      Int         @default(1)
  totalPrice    Float
  note          String?
  status        OrderStatus @default(PENDING)
  contactMethod String?
  address       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listingId     String
  buyerId       String

  listing Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User           @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  review  ListingReview?

  @@index([buyerId, status])
  @@index([listingId, status])
}

model ListingReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  listingId  String
  orderId    String   @unique
  reviewerId String

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, listingId])
  @@index([listingId])
  @@index([reviewerId])
}

model SavedListing {
  userId    String
  listingId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model ListingReport {
  id         String       @id @default(cuid())
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  listingId  String
  reporterId String

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, listingId])
  @@index([listingId])
  @@index([reporterId])
  @@index([status])
}

model Report {
  id           String           @id @default(cuid())
  reason       String
  targetType   ReportTargetType
  targetId     String
  status       ReportStatus     @default(PENDING)
  resolvedNote String?
  createdAt    DateTime         @default(now())
  reporterId   String
  jobPostId    String?

  reporter User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  jobPost  JobPost? @relation("JobPostReports", fields: [jobPostId], references: [id], onDelete: SetNull)

  @@index([status, targetType])
  @@index([reporterId])
  @@index([targetType, targetId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String?
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())
  profileId   String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ProviderVerificationRequest {
  id           String                     @id @default(cuid())
  providerId   String
  status       ProviderVerificationStatus @default(PENDING)
  note         String?
  reviewedNote String?
  reviewedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  provider User @relation("ProviderVerificationRequests", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@index([status, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  codeHash  String
  email     String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
